# Copie para .env e preencha. Nunca faça commit do .env.

# --- IA (opcional, recomendado) -------------------------------------------
# Habilita textos comerciais gerados por IA, regeneração de seções e sugestões.
# Sem a chave, o gerador usa modelos determinísticos por segmento (funcional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Places API (New) (opcional, recomendado) ----------------------
# Melhora a confirmação de ausência de site, telefone e horários.
# Ative "Places API (New)" no Google Cloud e restrinja a chave por IP/API.
GOOGLE_PLACES_API_KEY=

# --- OpenStreetMap (sem chave) ---------------------------------------------
# A política de uso do Nominatim exige identificar a aplicação. Informe um
# e-mail de contato do operador da plataforma.
OSM_CONTACT_EMAIL=
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Servidor --------------------------------------------------------------
PORT=3001
# Nome exibido no aviso de demonstração dos sites gerados
AGENCY_NAME=Prospecta

# --- Acesso ao Hub ----------------------------------------------------------
# Senha de login do Hub. Obrigatória em produção (o servidor não sobe sem ela).
HUB_PASSWORD=
# Segredo para assinar a sessão (qualquer texto longo e aleatório).
SESSION_SECRET=
# Endereço público usado nos links das demos (ex.: https://prospecta.onrender.com).
# Se vazio, é detectado automaticamente pelo endereço acessado.
PUBLIC_URL=
